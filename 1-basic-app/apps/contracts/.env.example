# Copiar a .env (nunca commitear .env).
# IMPORTANT: DO NOT USE A KEY THAT HOLDS REAL FUNDS.

# Private key of the MetaMask *dev* account (Account details → Show private key).
# Format: 0x + 64 hex chars. No quotes, no spaces, not the 12-word seed.
PRIVATE_KEY=

# Optional: verify source on Celoscan / Etherscan v2. Not needed to compile or deploy.
ETHERSCAN_API_KEY=

# Optional: set to "true" to print gas costs during tests. Leave empty for this lab.
REPORT_GAS=

# Optional: Hardhat already defaults these in hardhat.config.ts
CELO_RPC_URL=https://forno.celo.org
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org/
